
# Unsplash (destination photos) — https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Affiliate programs (leave blank until approved; links pass through untagged)
NEXT_PUBLIC_BOOKING_AFFILIATE_ID=
NEXT_PUBLIC_TM_IMPACT_URL=

# Optional: server-only Mapbox token for backend geocoding. Falls back to
# NEXT_PUBLIC_MAPBOX_TOKEN when unset. Set this before adding URL
# restrictions to the public token, or server-side geocoding breaks silently.
MAPBOX_SERVER_TOKEN=

# Canonical/OG/sitemap origin. Must be set in Vercel production or every
# canonical URL silently stays on scoutie.vercel.app after a domain cutover.
NEXT_PUBLIC_SITE_URL=
